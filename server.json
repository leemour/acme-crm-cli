{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.leemour/acme-crm-cli",
  "title": "Acme CRM example",
  "description": "An example WireCat CLI for a made-up CRM, synthetic data. Sign a profile in with acme-crm first.",
  "websiteUrl": "https://github.com/leemour/acme-crm-cli#readme",
  "repository": {
    "url": "https://github.com/leemour/acme-crm-cli",
    "source": "github"
  },
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@leemour/acme-crm-cli",
      "version": "0.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all"
        }
      ]
    }
  ]
}
