{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/acme-crm-cli",
  "title": "WireCat acme-crm",
  "description": "acme-crm for agents over MCP. Set up a profile with the acme-crm CLI first.",
  "websiteUrl": "https://wirecat.dev/en/docs/acme-crm",
  "repository": {
    "url": "https://github.com/leemour/acme-crm-cli",
    "source": "github"
  },
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@leemour/acme-crm-cli",
      "version": "0.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all"
        }
      ]
    }
  ]
}
