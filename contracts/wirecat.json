{
  "wcat_manifest": 2,
  "name": "acme-crm",
  "description": "a new WireCat CLI, started from cli-template",
  "docs_url": "https://github.com/leemour/acme-crm-cli#readme",
  "package": "@leemour/acme-crm-cli",
  "bin": "wcat-acme-crm",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "comments",
        "list"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "comments.list"
    },
    {
      "path": [
        "comments",
        "show"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "comments.show"
    },
    {
      "path": [
        "comments",
        "create"
      ],
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.create"
    },
    {
      "path": [
        "comments",
        "update"
      ],
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.update"
    },
    {
      "path": [
        "doctor"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "install"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "skill",
        "status"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "serve"
      ],
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "revoke"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "start"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "stop"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "status"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "config"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "add"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "check"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "upgrade"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "config",
        "set"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "unset"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "migrate"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "repair"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "runs",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "runs",
        "path"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    }
  ],
  "desktop": {
    "tagline": "A new WireCat CLI, started from cli-template",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "session",
      "start"
    ],
    "signIn": {
      "gives": "Lets your agent read and change your account through acme-crm.",
      "asks": "An API token or key from the service."
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": null,
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "leemour-acme-crm-cli",
      "env": "ACME_CRM"
    },
    "settings": null
  }
}
