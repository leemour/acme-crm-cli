{
  "wcat_manifest": 2,
  "name": "acme-crm",
  "description": "an example third-party WireCat CLI for Acme CRM, a made-up service with synthetic data",
  "docs_url": "https://github.com/leemour/acme-crm-cli#readme",
  "package": "@leemour/acme-crm-cli",
  "bin": "wcat-acme-crm",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "sync"
      ],
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "sync"
    },
    {
      "path": [
        "contacts",
        "list"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "contacts.list"
    },
    {
      "path": [
        "contacts",
        "show"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "contacts.show"
    },
    {
      "path": [
        "store",
        "status"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.status"
    },
    {
      "path": [
        "deals",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "deals.list"
    },
    {
      "path": [
        "deals",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "deals.show"
    },
    {
      "path": [
        "pipelines",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "pipelines.list"
    },
    {
      "path": [
        "pipelines",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "pipelines.show"
    },
    {
      "path": [
        "stages",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "stages.list"
    },
    {
      "path": [
        "fields",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "fields.list"
    },
    {
      "path": [
        "search",
        "all"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "search.all"
    },
    {
      "path": [
        "doctor"
      ],
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "install"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "skill",
        "status"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "serve"
      ],
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "revoke"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "start"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "stop"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "status"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "config"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "add"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "check"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "upgrade"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "config",
        "set"
      ],
      "effects": {
        "remote": "none",
        "local": "write"
