    {
      "path": [
        "runs",
        "list"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "runs",
        "path"
      ],
      "effects": {
        "remote": "none",
        "local": "none"
      }
    }
  ],
  "desktop": {
    "tagline": "Example CRM: Acme contacts, deals and invoices",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "session",
      "start"
    ],
    "signIn": {
      "gives": "Lets your agent read the Acme CRM workspace: contacts, deals and invoices.",
      "asks": "An Acme CRM API token. The example takes any acme_test_ token."
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": {
      "run": [
        "{profile}",
        "sync",
        "--record",
        "--json"
      ],
      "last": [
        "runs",
        "list",
        "command:sync",
        "status:success",
        "--limit",
        "50",
        "--no-record",
        "--json"
      ],
      "lastShape": "runs",
      "what": "contacts, deals and invoices",
      "note": null
    },
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "leemour-acme-crm-cli",
      "env": "ACME_CRM"
    },
    "settings": null
  }
}
